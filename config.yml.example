# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── REST-only mode ──
# The node uses WebSocket push whenever the panel offers it. Set ws.disable to
# talk to the panel over the REST API only, e.g. on hosts with dynamic IPs.
# Trade-offs: user/config changes apply on the next pull_interval instead of
# instantly, and the cross-node device limit (pushed over WS) is not enforced.
# Top-level ws.disable is inherited by every instance; an instance can set
# its own `ws: { disable: false }` (or true) to override it.
# ws:
#   disable: true
